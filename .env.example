# Copy to `.env` and adjust. Read by app.py and by the data pipeline.

# Hugging Face cache (models + WikiFragments). It needs ~1 TB of free space.
# HF_HOME=/path/to/hf_cache
# Set both to 1 once everything is downloaded, to avoid hub requests at startup.
# HF_HUB_OFFLINE=1
# HF_DATASETS_OFFLINE=1

# Qdrant server holding the `wikifragments-visual-arts-embeds` collection.
QDRANT_URL=http://localhost

# Generation engine: vllm (recommended) or hf.
# ARTSEEK_ENGINE=vllm
# Fraction of GPU memory vLLM may take; the retriever and LICN use the rest.
# ARTSEEK_GPU_MEMORY_UTILIZATION=0.65
# ARTSEEK_MAX_MODEL_LEN=16384
# ColQwen2 checkpoint (hub id or local path).
# ARTSEEK_RETRIEVER=vidore/colqwen2-v1.0

# Only needed to rebuild the datasets from scratch.
# ARTSEEK_DATA_DIR=data
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
